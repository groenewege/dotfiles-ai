#!/usr/bin/env bash
# Links the shared skills from ~/dotfiles-ai into ~/.claude/skills (which Amp
# reads) and writes /home/user/workspace/AGENTS.md, which Amp loads as a parent
# directory of the repository. Called by .agents/setup and .agents/resume.
set -euo pipefail

dotfiles_dir="$HOME/dotfiles-ai"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
agents_file="$(dirname "$repo_root")/AGENTS.md"

cd "$repo_root"
# shellcheck source=orb-config
. .agents/orb-config

"$dotfiles_dir/install.sh" >/dev/null

mysql_version="${MYSQL_SERIES#mysql-}"
if [ -n "$FRONTEND_BUILD_SCRIPT" ]; then
	frontend_note="Front-end
  assets are prebuilt; run \`npm run $FRONTEND_BUILD_SCRIPT\` after CSS/JS changes."
else
	frontend_note="The setup
  does not build front-end assets."
fi
composer_hosts=()
for entry in "${COMPOSER_HTTP_BASIC[@]}"; do
	composer_hosts+=("\`${entry%% *}\`")
done

tmp="$(mktemp)"
{
	cat <<EOF
# Amp orb notes (generated by .agents/sync-ai-config)

- This orb is a client-site checkout: apply the rules for projects in \`~/Sites\` below.
- Base branch is \`develop\`: commit and push there. Never push to \`staging\` or \`main\`;
  a pre-push hook enforces this.
- PHP $PHP_VERSION, Composer, Node and MySQL ${mysql_version%-lts} are installed. Databases: \`$DB_NAME\`
  (development, seeded) and \`$DB_TEST_NAME\` (tests, seeded), user \`laravel\` / \`password\`.
- Run the site with \`amp orb services ensure\` and share the printed portal URL. $frontend_note
EOF
	if [ ${#composer_hosts[@]} -gt 0 ]; then
		echo "- Login shells export \`COMPOSER_AUTH\` for ${composer_hosts[*]} from Amp project secrets."
	fi
	if [ -n "${ORB_NOTES:-}" ]; then
		echo "$ORB_NOTES"
	fi
	cat <<'EOF'
- Notion tools come from the `notion` remote MCP server (find them with tool_search).

# Shared instructions (from groenewege/dotfiles-ai)

EOF
	cat "$dotfiles_dir/AGENTS.md"
} >"$tmp"
mv "$tmp" "$agents_file"
