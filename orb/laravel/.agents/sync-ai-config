#!/usr/bin/env bash
# Links the shared skills from ~/dotfiles-ai into ~/.claude/skills (which Amp
# reads) and writes /home/user/workspace/AGENTS.md, which Amp loads as a parent
# directory of the repository. Called by .agents/setup and .agents/resume.
set -euo pipefail

dotfiles_dir="$HOME/dotfiles-ai"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
agents_file="$(dirname "$repo_root")/AGENTS.md"

"$dotfiles_dir/install.sh" >/dev/null

tmp="$(mktemp)"
cat >"$tmp" <<'EOF'
# Amp orb notes (generated by .agents/sync-ai-config)

- This orb is a client-site checkout: apply the rules for projects in `~/Sites` below.
- Base branch is `develop`: commit and push there. Never push to `staging` or `main`;
  a pre-push hook enforces this.
- PHP 8.3, Composer, Node and MySQL 8.0 are installed. Databases: `myproject`
  (development, seeded) and `myproject_test` (tests, seeded), user `laravel` / `password`.
- Run the site with `amp orb services ensure` and share the printed portal URL. Front-end
  assets are prebuilt; run `npm run build` after CSS/JS changes.
- Seeded logins (password in database/seeders/UserSeeder.php): `admin@example.com`
  (superadmin), `admin1@example.com`, `admin2@example.com`. Admin panel: `/admin`.
- Notion tools come from the `notion` remote MCP server (find them with tool_search).

# Shared instructions (from groenewege/dotfiles-ai)

EOF
cat "$dotfiles_dir/AGENTS.md" >>"$tmp"
mv "$tmp" "$agents_file"
